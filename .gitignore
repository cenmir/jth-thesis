# Intermediate / user-added PDFs are ignored by default, but the
# canonical rendered book is whitelisted so visitors to the repo can
# preview the template without rendering it locally.
*.pdf
!JTH-Thesis-Template.pdf

# Quarto cache and intermediate notebook artefacts.
.quarto/
**/*.quarto_ipynb

# LaTeX intermediates that may be left behind if a render is
# interrupted (otherwise Quarto cleans them up on success).
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk

# Editor / tool side-effects.
.claude/
.ipynb_checkpoints/
__pycache__/

/.quarto/
